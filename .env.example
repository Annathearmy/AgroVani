# Vercel / application
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=*

# Razorpay subscriptions / plan checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Driver navigation map
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Advisory data. Demo rows are clearly labeled until an official feed is configured.
AGMARKNET_SOURCE_URL=https://agmarknet.gov.in/
ADVISORY_DB_PATH=./data/agrovani.sqlite

# Primary production database: Supabase
# Add the real values in .env.local or Vercel Project Settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional local MongoDB fallback
MONGO_URL=mongodb://localhost:27017
DB_NAME=agrovani

# External data services
METEOBLUE_APIKEY=
CEHUB_APIKEY=

# India live weather map. Configure the Cloud Next Weather V3 endpoint when available.
CLOUD_NEXT_WEATHER_API_URL=
CLOUD_NEXT_WEATHER_API_KEY=
CLOUD_NEXT_WEATHER_API_VERSION=v3

# Gemini free-tier voice assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional low-latency Gemini Live agent through LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Aoede
